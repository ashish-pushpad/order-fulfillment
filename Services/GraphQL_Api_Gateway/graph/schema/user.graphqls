type User {
    id: ID!
    name: String
    email: String
    role: String
}

input NewUser {
    name: String!
    email: String!
    password_hash: String!
}

input UpdateUserData{
    name: String!
    email: String!
    password: String!
}

extend type Query {
    getUser(id: ID!): User!
}

extend type Mutation {
    createUser(input: NewUser!): User!
    updateUser (id:ID!,input:NewUser!):User!
    deleteUser (id:ID! ):User!
}